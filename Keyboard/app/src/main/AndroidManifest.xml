<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- דרוש לתמלול קולי בהחזקת מקש 0 (ראו KeyboardService.startVoiceTranscription) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- נחוץ כדי לקרוא את העיצוב המשותף (כהה/בהיר, צבע הדגשה) מ-FutureUI - ראו
         ההערה המקבילה במניפסט של dialer. -->
    <queries>
        <package android:name="com.future.futureui" />
        <!-- נחוץ כדי ש-SpeechRecognizer.isRecognitionAvailable/createSpeechRecognizer יראו
             שירותי תמלול קולי מותקנים במכשיר (חסימת package visibility מ-API 30 ומעלה
             חוסמת את השאילתה בלי הצהרה מפורשת כאן, גם אם השירות באמת קיים במכשיר). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keyboard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Keyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- שיטת קלט T9 חזויה - השירות שמיירט מקשי ספרות פיזיים ומתרגם אותם למילים -->
        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <receiver
            android:name=".KeyboardWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/app_widget_info" />
        </receiver>
    </application>

</manifest>
