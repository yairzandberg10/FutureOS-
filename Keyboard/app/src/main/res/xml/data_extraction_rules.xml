<?xml version="1.0" encoding="utf-8"?>
<!-- K-20: מילון ה-345MB (נבנה מחדש מה-assets) והעדפות/מילים שנלמדו לא נכללים בגיבוי ובהעברה בין מכשירים -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dict_he.db" />
        <exclude domain="database" path="dict_he.db.tmp" />
        <exclude domain="sharedpref" path="t9_keyboard_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dict_he.db" />
        <exclude domain="database" path="dict_he.db.tmp" />
    </device-transfer>
</data-extraction-rules>
