<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- minSdk 31 (Android 12) ומעלה - די בהרשאות הריצה החדשות, בלי fallback
         להרשאות הישנות (BLUETOOTH/BLUETOOTH_ADMIN) שנחוצות רק למכשירים ישנים
         יותר. neverForLocation על BLUETOOTH_SCAN כי האפליקציה לא נגזרת מיקום
         פיזי מתוצאות הסריקה (ר' Fitness/AndroidManifest.xml, אותו דפוס). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- מאנדרואיד 11 (API 30) ומעלה, ContentResolver.query() על ספק תוכן של
         אפליקציה אחרת מוחזר ריק בשקט אלא אם היא מוצהרת כאן - נחוץ כדי לקרוא
         את העיצוב המשותף (כהה/בהיר, צבע הדגשה) מ-FutureUI. -->
    <queries>
        <package android:name="com.future.futureui" />
    </queries>

    <uses-permission android:name="com.future.futureui.permission.SYSTEM_SETTINGS" />
    <uses-permission android:name="com.future.keyboard.permission.SETTINGS" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bluetooth">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Bluetooth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
