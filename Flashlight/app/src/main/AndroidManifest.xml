<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- setTorchMode לא דורש הרשאת CAMERA (ר' FlashlightController) -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- מאנדרואיד 11 (API 30) ומעלה, ContentResolver.query() על ספק תוכן של
         אפליקציה אחרת מוחזר ריק בשקט אלא אם היא מוצהרת כאן - נחוץ כדי לקרוא
         את העיצוב המשותף (כהה/בהיר, צבע הדגשה) מ-FutureUI. -->
    <queries>
        <package android:name="com.future.futureui" />
    </queries>

    <!-- שירות קדמי שמחזיק את הפנס דלוק כשהמסך נכבה (TorchService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="com.future.futureui.permission.SYSTEM_SETTINGS" />
    <uses-permission android:name="com.future.keyboard.permission.SETTINGS" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flashlight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Flashlight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".data.TorchService" android:exported="false" />
    </application>

</manifest>
