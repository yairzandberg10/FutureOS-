<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- minSdk 31 (Android 12) ומעלה - די בהרשאות הריצה החדשות, בלי fallback
         להרשאות הישנות (BLUETOOTH/BLUETOOTH_ADMIN) שנחוצות רק למכשירים ישנים
         יותר. neverForLocation על BLUETOOTH_SCAN כי האפליקציה לא נגזרת מיקום
         פיזי מתוצאות הסריקה (ר' Fitness/AndroidManifest.xml, אותו דפוס). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- "גלוי למכשירים אחרים": ACTION_REQUEST_DISCOVERABLE דורש אותה מ-targetSdk 31. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- "קבצים שהתקבלו": שירות ה-OPP של המערכת שומר אותם ב-Download, והרשומות
         שלו (שאינן מדיה) גלויות לאפליקציה אחרת רק עם גישה לכל הקבצים - כמו Files. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- מאנדרואיד 11 (API 30) ומעלה, ContentResolver.query() על ספק תוכן של
         אפליקציה אחרת מוחזר ריק בשקט אלא אם היא מוצהרת כאן - נחוץ כדי לקרוא
         את העיצוב המשותף (כהה/בהיר, צבע הדגשה) מ-FutureUI. -->
    <queries>
        <package android:name="com.future.futureui" />
        <!-- "קבצים שהתקבלו" פותח את אפליקציית הקבצים של המערכת. -->
        <package android:name="com.future.files" />
        <!-- "שלח קובץ" (בורר קבצים) ופתיחת קובץ שהתקבל, כשאין את Files. -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <uses-permission android:name="com.future.futureui.permission.SYSTEM_SETTINGS" />
    <!-- BT-30: allowBackup=false, ולכן כללי גיבוי/חילוץ לא נאכפים - הוסרו. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bluetooth">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Bluetooth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "שתף > בלוטוס" מכל אפליקציה: הקבצים נשלחים במסך בחירת המכשיר. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- פתיחה ושיתוף של קבצים שהתקבלו - הרשאת קריאה זמנית ל-Uri בלבד. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver
            android:name=".widget.BluetoothStatusWidgetProvider"
            android:label="@string/bt_status_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bluetooth_status_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.ReceivedFilesWidgetProvider"
            android:label="@string/bt_files_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bluetooth_files_widget_info" />
        </receiver>
    </application>

</manifest>
