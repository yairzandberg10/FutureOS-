<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (targetSdk 30+): בלי זה ה-ContentProvider-ים של
         FutureUI (ThemeClient) ושל המקלדת (KeyboardSettingsClient) נראים רק
         במקרה - כשהצד השני ניגש אלינו, או כשהמקלדת היא ה-IME הפעיל. אחרי
         התקנה מחדש של המקלדת זה נשבר: "Failed to find provider info" כל 15
         שניות, ומתג הניבוי במרכז הבקרה הראה ערך ברירת מחדל שעה שלמה. -->
    <!-- הרשאות החתימה של הסוויטה מוגדרות בכל אפליקציה, לא רק ב-FutureUI/במקלדת.
         אחרת, כשהן לא מותקנות, אפליקציה זרה יכלה להגדיר ראשונה הרשאה באותו שם
         ברמת normal - ולקבל כך גישה לכל מה שמוגן בה (מקלטים, ספקים, שידורים). -->
    <permission
        android:name="com.future.futureui.permission.SYSTEM_SETTINGS"
        android:protectionLevel="signature" />
    <permission
        android:name="com.future.keyboard.permission.SETTINGS"
        android:protectionLevel="signature" />
    <!-- שרת FutureOS ב-Settings: קריאת טוקן המכשיר, ושליחת דוחות קריסה ל-CrashReportReceiver.
         מוגדרת גם כאן מאותה סיבה שלמעלה. -->
    <permission
        android:name="com.future.settings.permission.FUTURE_SERVER"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.future.settings.permission.FUTURE_SERVER" />

    <queries>
        <package android:name="com.future.futureui" />
        <package android:name="com.future.keyboard" />
        <!-- "שלח משוב" ודוחות קריסה (crash/CrashCapture.kt, feedback/FeedbackShortcut.kt) -->
        <package android:name="com.future.settings" />
    </queries>

    <application>
        <!-- מתקין את המרווח משורת המצב של FutureUI בכל Activity של האפליקציה
             הצורכת (StatusBarInset.kt). initOrder גבוה כדי לרוץ לפני ספקים
             אחרים של האפליקציה. -->
        <provider
            android:name="com.future.sharednav.systemui.StatusBarInsetInstaller"
            android:authorities="${applicationId}.sharednav.statusbarinset"
            android:exported="false"
            android:initOrder="1000" />
        <!-- תפיסת קריסות (crash/CrashCapture.kt). initOrder גבוה יותר: מותקן ראשון,
             כדי לתפוס גם קריסה בספקים אחרים של האפליקציה. -->
        <provider
            android:name="com.future.sharednav.crash.CrashCaptureInstaller"
            android:authorities="${applicationId}.sharednav.crashcapture"
            android:exported="false"
            android:initOrder="2000" />
        <!-- טוען את שכבת התרגום (i18n/Tr.kt) לפני ספקי האפליקציה, כדי ש-tr() יעבוד גם בקוד שרץ מוקדם. -->
        <provider
            android:name="com.future.sharednav.i18n.TrInstaller"
            android:authorities="${applicationId}.sharednav.tr"
            android:exported="false"
            android:initOrder="1001" />
    </application>
</manifest>
