<?xml version="1.0" encoding="utf-8"?>
<!-- ווידג'ט השעון בסגנון iOS: כמו future_widget, והערך הוא TextClock חי
     (מתעדכן בלי הווידג'ט) בספרות גדולות ודקות. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/future_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/future_widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/future_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textColor="#FF0A84FF"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/future_widget_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="2dp" />

    <TextClock
        android:id="@+id/future_widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textColor="#FFFFFFFF"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/future_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textColor="#99EBEBF5"
        android:textSize="13sp" />
</LinearLayout>
