<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- נחוץ כדי לקרוא את העיצוב המשותף (כהה/בהיר, צבע הדגשה) מ-FutureUI
             דרך ה-ContentProvider שלה - חסום בשקט מאנדרואיד 11 בלי ההצהרה הזו. -->
        <package android:name="com.future.futureui" />
    </queries>

    <uses-permission android:name="com.future.futureui.permission.SYSTEM_SETTINGS" />
    <uses-permission android:name="com.future.keyboard.permission.SETTINGS" />
    <!-- ווידג'ט "אירועים קרובים" המובנה קורא את היומן של המערכת (שם אפליקציית
         היומן של FutureOS שומרת אירועים). מתבקש רק ב-OK על הווידג'ט. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- ווידג'ט "אנשי קשר מועדפים" (אנשי קשר שסומנו בכוכב) ו"צעדים היום"
         (חיישן TYPE_STEP_COUNTER). גם הן מתבקשות רק ב-OK על הווידג'ט. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- ווידג'ט "קישוריות": סוג החיבור ועוצמת ה-Wi-Fi (הרשאה רגילה, בלי בקשה) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FutureLauncher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FutureLauncher"
            android:launchMode="singleInstance"
            android:windowSoftInputMode="adjustResize">
            <!-- מסך הבית מצייר את הרקע עד הקצה ושומר מרווח משורת המצב בעצמו -->
            <meta-data android:name="com.future.sharednav.STATUS_BAR_INSET" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>