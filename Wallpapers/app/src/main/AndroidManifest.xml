<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.future.futureui" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="com.future.futureui.permission.SYSTEM_SETTINGS" />

    <!-- אין קטגוריית LAUNCHER: נפתחת מהלאנצ'ר (עריכה > רקע) ומההגדרות. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_wallpapers"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wallpapers">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Wallpapers">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- הקטלוג המובנה למסך הנעילה של FutureUI (שאין לו רשת). קריאה בלבד. -->
        <provider
            android:name=".WallpaperProvider"
            android:authorities="com.future.wallpapers.catalog"
            android:exported="true"
            android:readPermission="com.future.futureui.permission.SYSTEM_SETTINGS"
            android:writePermission="com.future.futureui.permission.SYSTEM_SETTINGS" />
    </application>

</manifest>
