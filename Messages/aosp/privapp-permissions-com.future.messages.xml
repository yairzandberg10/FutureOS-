<?xml version="1.0" encoding="utf-8"?>
<!-- הרשאות privileged של FutureOS Messages.
     שתי הרשאות ה-RCS מוגדרות ב-Android 12 כ-internal|role, והתפקיד היחיד
     שמעניק אותן הוא SYSTEM_SHELL - לא תפקיד ה-SMS. לכן תמונת FutureOS מוסיפה
     להן "privileged" (frameworks-base-rcs-privileged.patch), והן מאושרות כאן. -->
<permissions>
    <privapp-permissions package="com.future.messages">
        <permission name="android.permission.PERFORM_IMS_SINGLE_REGISTRATION" />
        <permission name="android.permission.ACCESS_RCS_USER_CAPABILITY_EXCHANGE" />
        <!-- SipDelegateManager.isSupported / מצב IMS של המנוי. -->
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    </privapp-permissions>
</permissions>
