<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- מאנדרואיד 11 (API 30) ומעלה, ContentResolver.query() על ספק תוכן של
         אפליקציה אחרת מוחזר ריק בשקט אלא אם היא מוצהרת כאן - נחוץ כדי לקרוא
         את העיצוב המשותף (כהה/בהיר, צבע הדגשה) מ-FutureUI. -->
    <queries>
        <!-- וגם כל אפליקציות המערכת - כדי להציג במדריך את האייקון האמיתי שלהן -->
        <package android:name="com.future.futureui" />
        <package android:name="com.future.futurelauncher" />
        <package android:name="com.future.dialer" />
        <package android:name="com.future.messages" />
        <package android:name="com.future.notes" />
        <package android:name="com.future.calendar" />
        <package android:name="com.future.contact" />
        <package android:name="com.future.files" />
        <package android:name="com.future.keyboard" />
        <package android:name="com.future.gallery" />
        <package android:name="com.future.music" />
        <package android:name="com.future.sfarim" />
        <package android:name="com.future.terminal" />
        <package android:name="com.future.tools" />
        <package android:name="com.future.tasks" />
        <package android:name="com.future.bluetooth" />
        <package android:name="com.future.navigation" />
        <package android:name="com.future.camera" />
        <package android:name="com.future.fitness" />
        <package android:name="com.future.remote" />
        <package android:name="com.future.assistant" />
        <package android:name="com.future.translate" />
        <package android:name="com.future.settings" />
    </queries>

    <uses-permission android:name="com.future.futureui.permission.SYSTEM_SETTINGS" />
    <uses-permission android:name="com.future.keyboard.permission.SETTINGS" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:appCategory="productivity"
        android:theme="@style/Theme.Guide">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Guide"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".GuideWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/app_widget_info" />
        </receiver>
    </application>

</manifest>
