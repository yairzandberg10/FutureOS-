<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- כדי לקרוא את העיצוב המשותף (כהה/בהיר, צבע הדגשה) מ-ContentProvider של
         FutureUI - מאנדרואיד 11 ומעלה חובה להצהיר על החבילה מראש. -->
    <queries>
        <package android:name="com.future.futureui" />
    </queries>

    <!-- חיבור שעון חכם/רצועת דופק ב-BLE (Heart Rate Service סטנדרטי) -
         neverForLocation כי הסריקה מסוננת לפי UUID של שירות, לא לצורכי
         מיקום, כך שאין צורך גם בהרשאת מיקום בשביל הסריקה עצמה. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- מעקב GPS חי במסך "ריצה" -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fitness">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Fitness"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
