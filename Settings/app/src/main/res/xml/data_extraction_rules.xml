<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (Android 12 and above).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- טוקן השרת לא נכנס לגיבוי ולא להעברה בין מכשירים -->
    <cloud-backup>
        <exclude domain="sharedpref" path="futureserver_credentials.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="futureserver_credentials.xml"/>
    </device-transfer>
</data-extraction-rules>
