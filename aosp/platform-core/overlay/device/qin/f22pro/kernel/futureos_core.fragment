# FutureOS platform-core: kernel defconfig fragment (MT6768, כנראה 4.14 android-vendor).
# הצהרה על האפשרויות שהסעיפים תלויים בהן. אפשרות שלא קיימת ב-Kconfig בפועל מדווחת על ידי
# merge_config.sh כ-not in final .config: זה צעד האימות. אימות במכשיר: adb shell zcat /proc/config.gz

# ליבה ותזמון (42, 43, 47, 52, 53, 73, 89, 90, 91)
CONFIG_SMP=y
CONFIG_HOTPLUG_CPU=y
CONFIG_PREEMPT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_COMMON=y
CONFIG_NO_HZ_IDLE=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# cgroups, namespaces, seccomp, PSI (61, 62, 63, 95, 109, 146, 192, 193, 198, 199)
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# זיכרון: zram, compaction (127, 128, 129, 144). lmkd עם PSI, בלי driver ישן בקרנל.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set

# הקשחה (102, 133, 134, 135, 136, 153, 155)
CONFIG_RANDOMIZE_BASE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_CC_STACKPROTECTOR_STRONG=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_HARDEN_BRANCH_PREDICTOR=y
CONFIG_ARM64_SSBD=y
# קרנל 5.3 ומעלה בלבד (ב-4.14 תדווח כלא קיימת):
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
# רק אם הקרנל נבנה ב-clang עם תמיכה:
# CONFIG_CFI_CLANG=y
# CONFIG_SHADOW_CALL_STACK=y

# RNG (71, 72)
CONFIG_HW_RANDOM=y

# פאניקה ויומן אתחול קודם (26, 50). נדרש גם צומת ramoops ב-DT של היצרן (ידני).
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# watchdog (27). MTK: השם עשוי להשתנות.
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y

# מערכות קבצים (201, 202, 207, 217, 220, 224, 229, 233)
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_ENCRYPTION=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_FUSE_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
# שמות קבצים בעברית ב-FAT/exFAT: UTF-8 (207, 754)
CONFIG_NLS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_FAT_DEFAULT_UTF8=y
# CONFIG_SDCARD_FS is not set

# אחסון נשלף ושינה (234, 243, 245, 561, 579)
CONFIG_USB_SUPPORT=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MMC=y
CONFIG_USB_SUSPEND=y
CONFIG_PM=y
CONFIG_PM_WAKELOCKS=y
CONFIG_SUSPEND=y
CONFIG_PM_AUTOSLEEP=y

# רשת: ספירת תעבורה לפי uid, חומת אש, tethering, VPN (334, 336, 337, 344, 345, 352)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_F_RNDIS=y
CONFIG_BT_BNEP=y
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_NET_KEY=y
