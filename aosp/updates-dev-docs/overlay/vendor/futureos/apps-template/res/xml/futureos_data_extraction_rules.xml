<?xml version="1.0" encoding="utf-8"?>
<!-- תבנית ל-android:dataExtractionRules (Android 12+) - מחליף את fullBackupContent.
     Manifest: android:dataExtractionRules="@xml/futureos_data_extraction_rules"
     cloud-backup: גיבוי לענן (כשיהיה transport כזה); device-transfer: העברה ישירה בין מכשירים / לכרטיס. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <exclude domain="sharedpref" path="lock_pin.xml"/>
        <exclude domain="file" path="face_templates/"/>
        <exclude domain="file" path="cache/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="user/"/>
        <exclude domain="sharedpref" path="lock_pin.xml"/>
        <exclude domain="file" path="face_templates/"/>
    </device-transfer>
</data-extraction-rules>
