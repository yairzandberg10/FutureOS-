<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- com.future.futureui: קריאת העיצוב המשותף (כהה/בהיר, צבע הדגשה).
         intent ה-LAUNCHER: כדי לאתר אפליקציות מותקנות ולפתוח אותן בפקודה
         קולית ("פתח מצלמה" וכו') - מאנדרואיד 11 ומעלה נדרשת הצהרה מפורשת. -->
    <queries>
        <package android:name="com.future.futureui" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- נחוץ כדי ש-SpeechRecognizer.isRecognitionAvailable/createSpeechRecognizer יראו
             שירותי תמלול קולי מותקנים במכשיר (חסימת package visibility מ-API 30 ומעלה
             חוסמת את השאילתה בלי הצהרה מפורשת כאן, גם אם השירות באמת קיים במכשיר). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- הרשאה "רגילה" (לא dangerous, אין דיאלוג) - בשביל פקודת "יש אינטרנט?". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- בשביל קריאה אמיתית של אירועי יומן ("מה יש לי היום") ואיתור אנשי
         קשר לפי שם ("התקשר לאמא") - שתיהן dangerous, נדרש אישור המשתמש. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assistant">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Assistant"
            android:excludeFromRecents="false"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
